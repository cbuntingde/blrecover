<Window x:Class="BlRecover.App.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Confirm destructive write" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceAltBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="30" Height="30"
                                     Foreground="{StaticResource BadBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="ActionText" Margin="12,0,0,0" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource InkStrongBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FlatCard}" Padding="14">
            <StackPanel>
                <TextBlock Text="What this will write" Style="{StaticResource SectionLabel}" />
                <ItemsControl x:Name="Details" />
                <Separator Margin="0,10,0,10" Background="{StaticResource LineSoftBrush}" />
                <TextBlock Text="Disk" Style="{StaticResource SectionLabel}" />
                <TextBlock x:Name="DeviceText" Style="{StaticResource Mono}" />
                <TextBlock x:Name="ModelText" Style="{StaticResource ValueText}" />
                <TextBlock x:Name="SerialText" Style="{StaticResource ValueText}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource BannerCard}" Margin="0,12,0,0"
                Background="#FFF6E5" BorderBrush="{StaticResource WarnBrush}">
            <TextBlock TextWrapping="Wrap" Foreground="#6B3F00" FontSize="12.5"
                       Text="A safety copy of the first and last 1 MiB of this disk has already been saved. Partition data itself is never written - only the partition table." />
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="PromptText" FontSize="13" Foreground="{StaticResource InkStrongBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <!-- The required token must be visible. The CLI prints it; the dialog used to ask the
                 operator to "type the token below" while showing no token at all, which made the
                 gate impossible to satisfy without reading the source. -->
            <TextBlock Text="Type this exact token to confirm:" FontSize="12.5"
                       Foreground="{StaticResource InkMutedBrush}" Margin="0,0,0,4" />
            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineSoftBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                <TextBlock x:Name="TokenText" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource InkStrongBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBox x:Name="TokenBox" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                     materialDesign:HintAssist.Hint="type the token shown above" />
            <TextBlock x:Name="MatchText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource InkMutedBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Click="OnCancel" Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource LineSoftBrush}" Foreground="{StaticResource InkStrongBrush}" />
            <Button x:Name="OkButton" Content="Write to disk" Click="OnOk"
                    Style="{StaticResource DangerButton}" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
