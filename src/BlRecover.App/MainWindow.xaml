<Window x:Class="BlRecover.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="BitLocker Partition Recovery" Height="880" Width="1320"
        MinHeight="620" MinWidth="1040"
        Background="{StaticResource SurfaceAltBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldLockOutline" Width="30" Height="30" Foreground="White"
                                             VerticalAlignment="Center" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BitLocker Partition Recovery" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Restore a deleted partition so Windows can see the volume again"
                                   Foreground="#CFE0F2" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Margin="0,0,10,0" Padding="10,4"
                            Background="{Binding ElevationBrushKey, Converter={StaticResource ResourceKeyToBrush}}"
                            ToolTip="{Binding ElevationHelp}">
                        <TextBlock Text="{Binding ElevationText}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <Button Content="Run as administrator" Command="{Binding ElevateCommand}" Padding="14,7"
                            Background="#33FFFFFF" Foreground="White" BorderThickness="0" FontSize="12"
                            Visibility="{Binding ShowElevateButton, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Diagnose" Command="{Binding DiagnoseCommand}" Padding="14,7" Margin="8,0,0,0"
                            Background="#33FFFFFF" Foreground="White" BorderThickness="0" FontSize="12" />
                    <Button Content="Self-test" Command="{Binding SelfTestCommand}" Padding="14,7" Margin="8,0,0,0"
                            Background="#33FFFFFF" Foreground="White" BorderThickness="0" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#E8F0F9" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" VerticalAlignment="Top"
                                         Margin="0,1,10,0" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource InkStrongBrush}"
                           Text="This tool rewrites the partition table only. It never decrypts BitLocker and never reads or stores keys. Once the partition entry is back, Windows mounts the volume as locked and you unlock it yourself with your password or 48-digit recovery key." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FlatCard}" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="PHYSICAL DISKS" Style="{StaticResource SectionLabel}" Margin="0" />
                        <TextBlock Text="Pick the drive that lost its partition." Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Content="Refresh" Command="{Binding RefreshDisksCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                    <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FlatCard}" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Index}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                            <Border Style="{StaticResource Chip}" Background="{StaticResource WarnBrush}"
                                                    HorizontalAlignment="Right" Padding="7,1"
                                                    Visibility="{Binding IsBoot, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="BOOT" Style="{StaticResource ChipText}" FontSize="10" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                                   TextWrapping="Wrap" Foreground="{StaticResource InkStrongBrush}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CardSubtitle}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- The TabControl must take the remaining height. In an Auto row it grows to
                         its content's full height, overflows the window and gets clipped - which left
                         the "Write partition entry" button unreachable and the tab's own
                         ScrollViewers with no height to scroll in. -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource FlatCard}" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkStrongBrush}" />
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,12,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Inspect" Command="{Binding InspectCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Scan for deleted volumes" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Back up partition table" Command="{Binding BackupOnlyCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                            Background="Transparent" BorderThickness="0">
                    <TabItem Header="Overview">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource BannerCard}" Background="#E6F4EC" BorderBrush="{StaticResource GoodBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Partition table" Style="{StaticResource CardSubtitle}" />
                                        <TextBlock Text="{Binding HealthText}" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{StaticResource InkStrongBrush}" />
                                        <TextBlock Text="{Binding RecoveryHint}" Style="{StaticResource CardSubtitle}"
                                                   Margin="0,6,0,0" FontSize="12.5" />
                                        <Button Content="Restore primary GPT from backup GPT" Margin="0,12,0,0"
                                                Command="{Binding RestoreFromBackupCommand}" Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding CanRestoreFromBackup, Converter={StaticResource BoolToVis}}" />
                                        <!-- Rebuilding the primary GPT refuses to run on the boot disk unless this is
                                             ticked, so the control has to live on this tab too, not only on the
                                             "Add partition entry" tab. Shared with Force. -->
                                        <CheckBox Content="This is the boot disk and I still want to proceed (advanced)"
                                                  IsChecked="{Binding Force}" Margin="0,10,0,0"
                                                  Foreground="{StaticResource InkStrongBrush}"
                                                  Visibility="{Binding SelectedIsBoot, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Structure" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="MBR (LBA 0)" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding MbrSummary}" Style="{StaticResource ValueText}" />
                                        <TextBlock Text="Primary GPT" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding PrimaryGptSummary}" Style="{StaticResource ValueText}" />
                                        <TextBlock Text="Trailing backup GPT" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="{Binding BackupGptSummary}" Style="{StaticResource ValueText}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Partitions" Style="{StaticResource CardTitle}" />
                                        <DataGrid ItemsSource="{Binding Partitions}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                                  BorderThickness="0" Background="Transparent" RowHeight="30"
                                                  AlternatingRowBackground="{StaticResource SurfaceAltBrush}"
                                                  FontSize="12.5">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="60" />
                                                <DataGridTextColumn Header="LBA range" Binding="{Binding Range}" Width="*" />
                                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
                                                <DataGridTextColumn Header="Name / type" Binding="{Binding Name}" Width="*" />
                                                <DataGridTextColumn Header="Detail" Binding="{Binding Type}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="No partitions in the table." Style="{StaticResource CardSubtitle}"
                                                   Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Scan">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource FlatCard}" Padding="14" Margin="0,0,0,10">
                                <WrapPanel>
                                    <TextBlock Text="Scan options" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <CheckBox Content="Scan the whole device (slower)" IsChecked="{Binding ScanWholeDevice}"
                                              VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <TextBlock Text="Alignment" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{StaticResource InkMutedBrush}" />
                                    <ComboBox Width="170" SelectedValuePath="Tag" SelectedValue="{Binding AlignKb}"
                                              VerticalAlignment="Center" Margin="0,0,16,0">
                                        <ComboBoxItem Content="1 MiB  (fast, default)" Tag="1024" />
                                        <ComboBoxItem Content="64 KiB  (very fast)" Tag="64" />
                                        <ComboBoxItem Content="512 KiB  (thorough)" Tag="512" />
                                    </ComboBox>
                                    <TextBlock Text="Stop after (MB, 0 = all)" VerticalAlignment="Center"
                                               Foreground="{StaticResource InkMutedBrush}" />
                                    <TextBox Width="90" Text="{Binding MaxOffsetMb}" VerticalAlignment="Center" />
                                    <Button Content="Scan" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" />
                                </WrapPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Volumes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FlatCard}" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="LockOpenOutline" Width="20" Height="20"
                                                                                     VerticalAlignment="Center"
                                                                                     Foreground="{StaticResource PrimaryBrush}" />
                                                            <TextBlock FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                                                       Foreground="{StaticResource InkStrongBrush}"
                                                                       Text="{Binding StartLba, StringFormat='Deleted volume at LBA {}{0}'}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Border Style="{StaticResource Chip}" Background="{StaticResource PrimaryBrush}" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Variant}" Style="{StaticResource ChipText}" FontSize="10" />
                                                            </Border>
                                                            <Border Style="{StaticResource Chip}" Background="{StaticResource GoodBrush}"
                                                                    Visibility="{Binding InsideLivePartition, Converter={StaticResource InverseBoolToVis}}">
                                                                <TextBlock Text="{Binding BlocksReadable, StringFormat='{}{0}/3 metadata blocks'}" Style="{StaticResource ChipText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,12,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                            <TextBlock Text="Volume GUID" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                                                            <TextBlock Text="{Binding VolumeGuid}" Style="{StaticResource Mono}" />
                                                            <TextBlock Text="Encryption" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding Encryption}" Style="{StaticResource ValueText}" />
                                                            <TextBlock Text="Layout" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding Variant}" Style="{StaticResource ValueText}" />
                                                            <TextBlock Text="Enabled" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding Created}" Style="{StaticResource ValueText}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="Volume extent" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                                                            <TextBlock Text="{Binding EncryptedSize}" Style="{StaticResource ValueText}" />
                                                            <TextBlock Text="Key protectors" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding Protectors}" Style="{StaticResource ValueText}" TextWrapping="Wrap" />
                                                            <TextBlock Text="You will need" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding Credential}" Style="{StaticResource ValueText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Note}" Style="{StaticResource CardSubtitle}"
                                                                       Foreground="{StaticResource WarnBrush}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6"
                                                            Padding="12" Margin="0,12,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="SUGGESTED PARTITION RANGE" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="LBA" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                           Foreground="{StaticResource InkMutedBrush}" />
                                                                <TextBox Width="130" Text="{Binding StartLba}" IsReadOnly="True" IsEnabled="False" />
                                                                <TextBlock Text="to" VerticalAlignment="Center" Margin="10,0" />
                                                                <TextBox Width="170" Text="{Binding SuggestedLastLba}" IsReadOnly="True" IsEnabled="False" />
                                                                <TextBlock Text="{Binding SuggestedSize}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                           Foreground="{StaticResource InkMutedBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Text="You can fine-tune the range on the Restore tab before writing."
                                                                       Style="{StaticResource CardSubtitle}" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                        <Button Content="Go to Restore" Command="{Binding NavigateRestoreCommand}"
                                                                Style="{StaticResource PrimaryButton}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Restore">
                        <!-- The commit buttons live in a pinned footer, not at the bottom of the
                             scrolling content. An operator who has just ticked the two
                             confirmations must never have to hunt for the button that writes to a
                             physical disk, and a short window must not be able to hide it. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,10,0,0">
                                <StackPanel>
                                <Border Style="{StaticResource BannerCard}" Background="#FDECEA" BorderBrush="{StaticResource BadBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AlertOutline" Width="20" Height="20"
                                                                     Foreground="{StaticResource BadBrush}" VerticalAlignment="Top" />
                                            <TextBlock Text="This writes to a physical disk" Margin="10,0,0,0" FontSize="15"
                                                       FontWeight="SemiBold" Foreground="{StaticResource InkStrongBrush}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CardSubtitle}" Margin="30,6,0,0"
                                                   Text="Only the partition table is rewritten. Sector data is never touched, and the first and last 1 MiB are copied to a safety folder before the first write. A confirmation dialog follows, and you must type the disk's serial token." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="1. Choose the target range" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding SelectedVolumeSummary}" Style="{StaticResource Mono}"
                                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0" />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="First LBA" VerticalAlignment="Center"
                                                       Margin="0,0,14,6" Foreground="{StaticResource InkMutedBrush}" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FirstLbaText}" Margin="0,0,0,6" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Last LBA" VerticalAlignment="Center"
                                                       Margin="0,0,14,6" Foreground="{StaticResource InkMutedBrush}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LastLbaText}" Margin="0,0,0,6" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" VerticalAlignment="Center"
                                                       Margin="0,0,14,6" Foreground="{StaticResource InkMutedBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ComputedSizeText}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,6" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Partition name" VerticalAlignment="Center"
                                                       Margin="0,0,14,6" Foreground="{StaticResource InkMutedBrush}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PartitionName}" Margin="0,0,0,6" />
                                        </Grid>

                                        <TextBlock Text="Safety backup folder" Style="{StaticResource SectionLabel}" />
                                        <TextBox Text="{Binding BackupDirectory}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="2. Confirm" Style="{StaticResource CardTitle}" />
                                        <CheckBox Content="I have the BitLocker unlock password or 48-digit recovery key"
                                                  IsChecked="{Binding HasKey}" Margin="0,4,0,8" />
                                        <CheckBox Content="I understand this writes to the physical disk and can make it unbootable if I pick the wrong drive."
                                                  IsChecked="{Binding Understands}" Margin="0,0,0,4" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,12">
                                    <StackPanel>
                                        <TextBlock Text="3. After a successful restore" Style="{StaticResource CardTitle}" />

                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="14"
                                                Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="AFTER A SUCCESSFUL RESTORE" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                                <TextBlock Style="{StaticResource ValueText}" TextWrapping="Wrap"
                                                           Text="1. Open an elevated command prompt and run:  diskpart  then  rescan&#10;2. Run:  manage-bde -status   - your volume should be listed and locked&#10;3. Open it in File Explorer and unlock with your password or recovery key&#10;4. If it unlocks, your data is intact. Take a backup immediately." />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Pinned action bar: always visible, whatever the window height. -->
                            <Border Grid.Row="1" Style="{StaticResource FlatCard}" Margin="0,10,0,0" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Style="{StaticResource CardSubtitle}" TextWrapping="Wrap"
                                                   Text="Tick both confirmations above, then write - you will be asked to type the disk's serial token. Requires the Manage Volume privilege; if the buttons are greyed out, use &quot;Run as administrator&quot; in the header." />
                                        <!-- The override lives with the button it unlocks, so a short
                                             window can never hide the one control that bypasses a
                                             safety warning. -->
                                        <CheckBox Content="Override safety warnings - live-partition overlap, or the boot disk (advanced)"
                                                  IsChecked="{Binding Force}" Margin="0,6,0,0"
                                                  Foreground="{StaticResource InkStrongBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Write partition entry" Command="{Binding AddEntryCommand}"
                                                Style="{StaticResource DangerButton}" />
                                        <Button Content="Back up table only" Command="{Binding BackupOnlyCommand}"
                                                Margin="8,0,0,0" />
                                        <Button Content="Copy equivalent CLI command" Command="{Binding CopyPlanCommand}"
                                                Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>

                <TextBlock Grid.Row="2" VerticalAlignment="Top" Margin="0,20,0,0"
                           HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource InkMutedBrush}"
                           Text="Select a disk, then Inspect or Scan."
                           Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="#111820" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,8,14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ACTIVITY LOG" Foreground="#7F93A6" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LogLines.Count, StringFormat='{}{0} lines'}" Foreground="#5A6B7C"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Copy command" Command="{Binding CopyPlanCommand}" Padding="10,3" FontSize="11"
                                Background="#22303C" Foreground="#C8D6E2" BorderThickness="0" Margin="0,0,6,0" />
                        <Button Content="Copy log" Command="{Binding CopyLogCommand}" Padding="10,3" FontSize="11"
                                Background="#22303C" Foreground="#C8D6E2" BorderThickness="0" Margin="0,0,6,0" />
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" Padding="10,3" FontSize="11"
                                Background="#22303C" Foreground="#C8D6E2" BorderThickness="0" Margin="0,0,6,0" />
                        <Button Content="Hide" Command="{Binding ToggleLogCommand}" Padding="10,3" FontSize="11"
                                Background="#22303C" Foreground="#C8D6E2" BorderThickness="0" />
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="LogScroll" MaxHeight="190" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="14,0,14,10">
                    <ItemsControl ItemsSource="{Binding LogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource LogLine}" Text="{Binding Text}"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource LineSoftBrush}" Padding="20,7">
            <TextBlock FontSize="11.5" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap"
                       Text="Never format or initialise the disk. If a recovery tool says the volume is gone, stop using that disk - every write can destroy more of it." />
        </Border>
    </Grid>
</Window>
